# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGINS=*

# MongoDB Atlas URI (Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority)
# For local dev / testing, use local or memory / Atlas cluster connection string
MONGODB_URI=mongodb://127.0.0.1:27017/hardware_store_db

# JWT Secrets (Generate strong 256-bit keys for production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_super_secure_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
